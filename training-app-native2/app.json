{
  "expo": {
    "name": "AI CycleNote",
    "slug": "training-app-native2",
    "scheme": "trainingapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haru7153.aicyclenote",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "体重データをヘルスケアから読み込むために使用します",
          "NSHealthUpdateUsageDescription": "記録した体重データをヘルスケアに書き込むために使用します",
          "background": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1c052a09-fb80-4f59-b5e3-ba7676780a80"
      }
    }
  }
}
