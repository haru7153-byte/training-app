# Client (Expo) — safe to expose, EXPO_PUBLIC_* is bundled into the app
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_BASE_URL=https://your-deployment.example.com

# Server (serverless functions under /api/rideverse) — NEVER expose to the client
OPENAI_API_KEY=sk-...
# Model IDs are overridable per environment without touching code (see api/rideverse/_lib/config.js)
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# The official "Velia #001 — Riviera" reference sheet (v002) is checked in at
# rideverse/design/official-velia-002-reference.png and used as a written
# style note (see api/rideverse/_lib/veriaDesignReference.js) — no env var needed.
